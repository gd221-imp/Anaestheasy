{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-GB",
  "import": [
    "@cspell/dict-en-gb/cspell-ext.json",
    "https://cdn.jsdelivr.net/npm/@cspell/dict-scientific-terms-gb@latest/cspell-ext.json",
    "@cspell/dict-html/cspell-ext.json",
    "./.cspell/drug-brand-replacements.json"
  ],
  "dictionaries": [
    "en-gb",
    "scientific-terms-gb",
    "html",
    "uk-anaesthesia"
  ],
  "dictionaryDefinitions": [
    {
      "name": "uk-anaesthesia",
      "path": "./.cspell/uk-anaesthesia.txt",
      "description": "UK Anaesthetic, Critical Care, Pain, and NHS clinical terms"
    }
  ],
  "ignorePaths": [
    ".git/**",
    ".github/**",
    ".githooks/**",
    ".cspell/**",
    ".pytest_cache/**",
    "**/__pycache__/**",
    ".gitignore",
    "cspell.json",
    "package.json",
    "package-lock.json",
    "dist/**",
    "node_modules/**",
    "tools/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.svg",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.ico",
    "**/*.woff",
    "**/*.woff2"
  ],
  "words": [
    "Anaestheasy",
    "Griffiths"
  ]
}
