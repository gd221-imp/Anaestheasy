{
  "json.schemas": [
    {"fileMatch": ["content/**/stop.json"], "url": "./.vscode/schemas/stop.schema.json"},
    {"fileMatch": ["content/**/quiz.json"], "url": "./.vscode/schemas/quiz.schema.json"},
    {"fileMatch": ["content/sba/*/*.json", "!content/sba/*/_*.json"], "url": "./.vscode/schemas/sba.schema.json"},
    {"fileMatch": ["content/**/placement.json"], "url": "./.vscode/schemas/placement.schema.json"}
  ],

  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {"**/__pycache__": true, "**/.pytest_cache": true},
  "search.exclude": {"dist/**": true, "**/node_modules": true},

  "editor.formatOnSave": false,
  "[html]": {
    "editor.wordWrap": "on",
    "editor.defaultFormatter": null,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },
  "[json]": {"editor.tabSize": 2, "editor.insertSpaces": true},
  "[javascript]": {"editor.defaultFormatter": "esbenp.prettier-vscode"},
  "[css]": {"editor.defaultFormatter": "esbenp.prettier-vscode"},

  "cSpell.language": "en-GB",
  "cSpell.enableFiletypes": ["html", "json", "markdown"],

  "githubPullRequests.pullBranch": "never",
  "githubPullRequests.defaultMergeMethod": "squash",
  "git.branchPrefix": "",
  "git.confirmSync": true
}
