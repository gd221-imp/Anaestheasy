{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check (run before every pull request)",
      "type": "shell",
      "command": "python3 tools/check.py",
      "windows": {"command": "python tools/check.py"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Build and open preview",
      "type": "shell",
      "command": "python3 tools/build.py && python3 -m webbrowser -t dist/index.html",
      "windows": {"command": "python tools/build.py; start dist/index.html"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Smoke test (opens every screen; needs Node 22 and Chrome)",
      "type": "shell",
      "command": "python3 tools/build.py && node tools/smoke_test.js",
      "windows": {"command": "python tools/build.py; node tools/smoke_test.js"},
      "problemMatcher": []
    }
  ]
}
